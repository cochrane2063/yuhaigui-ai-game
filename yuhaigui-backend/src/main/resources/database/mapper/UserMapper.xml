<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yupi.yuhaigui.database.mapper.UserMapper">

    <resultMap id="UserMap" type="com.yupi.yuhaigui.database.model.User">
        <id column="uuid" property="uuid"/>
        <result column="username" property="username"/>
        <result column="password_hash" property="passwordHash"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="selectByUsername" parameterType="string" resultMap="UserMap">
        select uuid, username, password_hash, created_at
        from users
        where username = #{username}
    </select>

    <insert id="insert" parameterType="com.yupi.yuhaigui.database.model.User">
        insert into users (username, password_hash)
        values (#{username}, #{passwordHash})
    </insert>

</mapper>