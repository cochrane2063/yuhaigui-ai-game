<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yupi.yuhaigui.database.mapper.ChatMessageMapper">

    <resultMap id="ChatMessageResultMap" type="com.yupi.yuhaigui.database.model.ChatMessage">
        <id property="messageId" column="message_id"/>
        <result property="sessionId" column="session_id"/>
        <result property="messageOrder" column="message_order"/>
        <!-- use typeHandler + javaType for enums to map DB varchar -> enum name -->
        <result property="type" column="type"
                javaType="dev.langchain4j.data.message.ChatMessageType"/>
        <result property="message" column="message"/>
    </resultMap>

    <insert id="insert" parameterType="com.yupi.yuhaigui.database.model.ChatMessage" useGeneratedKeys="true" keyProperty="messageId">
        INSERT INTO chat_message (session_id, message_order, type, message)
        VALUES (#{sessionId}, #{messageOrder}, #{type}, #{message})
    </insert>

    <select id="selectById" resultMap="ChatMessageResultMap" parameterType="int">
        SELECT message_id, session_id, message_order, type, message
        FROM chat_message
        WHERE message_id = #{messageId}
    </select>

    <select id="selectBySessionId" resultMap="ChatMessageResultMap" parameterType="int">
        SELECT message_id, session_id, message_order, type, message
        FROM chat_message
        WHERE session_id = #{sessionId}
        ORDER BY message_order ASC
    </select>

    <update id="update" parameterType="com.yupi.yuhaigui.database.model.ChatMessage">
        UPDATE chat_message
        SET session_id = #{sessionId},
        message_order = #{messageOrder},
        type = #{type},
        message = #{message}
        WHERE message_id = #{messageId}
    </update>

    <delete id="deleteById" parameterType="int">
        DELETE FROM chat_message WHERE message_id = #{messageId}
    </delete>
</mapper>